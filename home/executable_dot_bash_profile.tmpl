__conda_root='{{ $condaRoot | replace "'" "'\"'\"'" }}'
__conda_setup="$(CONDA_REPORT_ERRORS=false "$__conda_root/bin/conda" shell.bash hook 2> /dev/null)"
if [ $? -eq 0 ]; then
