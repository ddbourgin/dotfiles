### OSX.gitignore
*.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk


### Vim.gitignore
# swap
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
# session
Session.vim
# temporary
.netrwhist
*~
# auto-generated tag files
tags


# Keep local SSH files, including all private keys, out of the repository.
/ssh/*
!/ssh/config

# opencode local credentials and runtime dependencies
/opencode/-sh
/opencode/opencode.jsonc.bak
/opencode/service.json
/opencode/node_modules/
home/dot_config/opencode/-sh
home/dot_config/opencode/opencode.jsonc.bak
home/dot_config/opencode/service.json
home/dot_config/opencode/node_modules/

# Neovim runtime and development files (also ignored by its target .gitignore)
home/dot_config/nvim/**/tt.*
home/dot_config/nvim/**/.tests
home/dot_config/nvim/doc/tags
home/dot_config/nvim/**/debug
home/dot_config/nvim/**/.repro
home/dot_config/nvim/**/foo.*
home/dot_config/nvim/**/*.log
home/dot_config/nvim/**/data

# Python test cache
__pycache__/
